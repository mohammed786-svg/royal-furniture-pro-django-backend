# Royal Furniture Pro — Environment Template
DJANGO_ENV=development
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (PgBouncer port 6432 in production, 5432 direct in dev)
DB_NAME=royal_furniture_db
DB_USER=postgres
DB_PASSWORD=SamRocks786
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SCHEMA=royal
READ_DB_HOST=
READ_DB_PORT=6432

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
ADMIN_SESSION_HOURS=12

# CORS / Frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Media / CDN
MEDIA_URL=/media/
MEDIA_ROOT=media
# Public origin for uploaded files (no trailing slash). Used by frontend via nginx /media/
CDN_URL=https://royalfurniturepro.azdeploy.com

# Shiprocket
# Shiprocket (see deploy/vps/SHIPROCKET.md)
SHIPROCKET_ENABLED=True
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in
SHIPROCKET_EMAIL=@gmail.com
SHIPROCKET_PASSWORD=Change-ME
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_DEFAULT_WEIGHT_KG=1.0
SHIPROCKET_DEFAULT_LENGTH_CM=10
SHIPROCKET_DEFAULT_BREADTH_CM=10
SHIPROCKET_DEFAULT_HEIGHT_CM=10
# Optional warehouse address for Shiprocket return pickups (defaults shown)
# SHIPROCKET_WAREHOUSE_NAME=Royal Furniture Pro
# SHIPROCKET_WAREHOUSE_ADDRESS=Your warehouse street address
# SHIPROCKET_WAREHOUSE_CITY=Mumbai
# SHIPROCKET_WAREHOUSE_STATE=Maharashtra
# SHIPROCKET_WAREHOUSE_PINCODE=400001
# SHIPROCKET_WAREHOUSE_PHONE=9999999999

# SMTP
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# SMS / WhatsApp
SMS_API_KEY=
WHATSAPP_API_KEY=

# WebSocket public URL (for clients)
WS_PUBLIC_URL=ws://localhost:8000/ws/

# API payload encryption (64 hex chars = 32 bytes; must match frontend NEXT_PUBLIC_API_CRYPTO_KEY)
# Generate: openssl rand -hex 32
API_CRYPTO_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
API_ENCRYPTION_ENABLED=True

# Server-side API/SQL debug logs (set False to silence all prints)
DEBUG_API_LOGS=False
