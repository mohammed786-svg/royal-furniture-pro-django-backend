# Royal Furniture Pro — VPS production environment
# Copy to: /root/royal-furniture-pro-django-backend/.env

DJANGO_ENV=production
SECRET_KEY=CHANGE-ME-long-random-secret
DEBUG=False
ALLOWED_HOSTS=royalfurniturepro.azdeploy.com,62.72.57.222,localhost,127.0.0.1

# PostgreSQL
DB_NAME=royal_furniture_db
DB_USER=postgres
DB_PASSWORD=CHANGE-ME
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SCHEMA=royal

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# JWT
JWT_SECRET_KEY=CHANGE-ME-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
ADMIN_SESSION_HOURS=12

# CORS / Frontend (add http://localhost:3000 when using local UI against VPS dev API)
CORS_ALLOWED_ORIGINS=https://royalfurniturepro.azdeploy.com,http://localhost:3000,http://127.0.0.1:3000

# Media (nginx serves /media/ from this directory)
MEDIA_URL=/media/
MEDIA_ROOT=/var/www/html/royal_furniture_pro_media
STATIC_URL=/static/
STATIC_ROOT=/var/www/html/royal_furniture_pro_static
CDN_URL=https://royalfurniturepro.azdeploy.com

# WebSocket
WS_PUBLIC_URL=wss://royalfurniturepro.azdeploy.com/ws/

# API encryption — must match frontend NEXT_PUBLIC_API_CRYPTO_KEY
# Generate: openssl rand -hex 32
API_CRYPTO_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
API_ENCRYPTION_ENABLED=True
DEBUG_API_LOGS=False

# Shiprocket (see deploy/vps/SHIPROCKET.md)
SHIPROCKET_ENABLED=True
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in
SHIPROCKET_EMAIL=your-api-user@example.com
SHIPROCKET_PASSWORD=CHANGE-ME
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_DEFAULT_WEIGHT_KG=1.0

# Firebase Google auth (see deploy/vps/FIREBASE_GOOGLE_LOGIN.md)
FIREBASE_PROJECT_ID=royal-furniture-pro
FIREBASE_CREDENTIALS_PATH=/root/royal-furniture-pro-django-backend/secrets/firebase-service-account.json

# Gunicorn (production service uses port 4000)
GUNICORN_BIND=127.0.0.1:4000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
