# Royal Furniture Pro — Frontend production
# Copy to: /var/www/html/royal_furniture_pro_website/royal-furniture-pro-frontend/.env.production

NODE_ENV=production
PORT=3010

# Public site origin (change when domain changes, e.g. https://royalfurniturepro.in)
NEXT_PUBLIC_APP_URL=https://royalfurniturepro.azdeploy.com
NEXT_PUBLIC_API_URL=https://royalfurniturepro.azdeploy.com/api/v1
NEXT_PUBLIC_MEDIA_BASE_URL=https://royalfurniturepro.azdeploy.com
NEXT_PUBLIC_WS_URL=wss://royalfurniturepro.azdeploy.com/ws/

# Must match backend API_CRYPTO_KEY
NEXT_PUBLIC_API_CRYPTO_KEY=CHANGE-ME-64-hex-characters-for-32-byte-aes-key-here-0123456789ab
