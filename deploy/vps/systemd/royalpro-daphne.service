[Unit]
Description=Royal Furniture Pro Django Channels (Daphne ASGI)
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
WorkingDirectory=/root/royal-furniture-pro-django-backend
Environment=PYTHONUNBUFFERED=1
Environment=DJANGO_ENV=production
EnvironmentFile=-/root/royal-furniture-pro-django-backend/.env
ExecStart=/root/royal-furniture-pro-django-backend/venv/bin/daphne \
  -b 127.0.0.1 \
  -p 7002 \
  config.asgi:application
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
